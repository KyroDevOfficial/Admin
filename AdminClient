-- ========== EXECUTE ==========
local function executeCommand()
	local text = commandBox.Text
	if text == "" then return end

	for _, line in ipairs(string.split(text, "\n")) do
		line = line:gsub("^%s+", ""):gsub("%s+$", "")
		if line == "" or line:match("^%-%-") then continue end

		local words = {}
		for w in line:gmatch("%S+") do table.insert(words, w) end
		if #words == 0 then continue end

		local raw = words[1]:lower()
		table.remove(words, 1)

		local map = {
			fly = "Fly", noclip = "Noclip", god = "God", speed = "Speed",
			jumppower = "JumpPower", heal = "Heal", forcefield = "ForceField",
			kill = "Kill", respawn = "Respawn", bring = "Bring", teleport = "Teleport",
			freeze = "Freeze", unfreeze = "Unfreeze", setstat = "SetStat",
			addstat = "AddStat", godstats = "GodStats", normalstats = "NormalStats",
			time = "Time", gravity = "Gravity", announce = "Announce",
		}

		local cmd = map[raw] or (raw:sub(1,1):upper() .. raw:sub(2))
		local targetName = nil
		local args = {}

		if #words > 0 then
			targetName = words[1]
			table.remove(words, 1)
			args = words
		end

		RE_Execute:FireServer(cmd, targetName, args)
	end
end

