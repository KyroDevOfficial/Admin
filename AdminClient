-- ========== WINDOW CONTROLS ==========
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = window.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	window.Visible = false
end)

minBtn.MouseButton1Click:Connect(function()
	contentArea.Visible = not contentArea.Visible
	toolbar.Visible = contentArea.Visible
end)

-- ========== TOGGLE PANEL ==========
local function togglePanel()
	window.Visible = not window.Visible
	if window.Visible then
		RE_RequestPanel:FireServer()
		setPage("Executor")
	end
end

-- RightCtrl
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightControl then
		togglePanel()
	end
end)

-- ========== TOOL HOOK (VERY STRONG) ==========
local function onToolActivated()
	togglePanel()
end

local function hookTool(tool: Tool)
	if tool:GetAttribute("AdminHooked") then return end
	tool:SetAttribute("AdminHooked", true)

	tool.Activated:Connect(onToolActivated)
	print("[AdminPanel] Hooked tool")
end

local function scanForTool()
	local bp = player:FindFirstChild("Backpack")
	if bp then
		local t = bp:FindFirstChild("Admin Tool")
		if t and t:IsA("Tool") then
			hookTool(t)
		end
	end

	local char = player.Character
	if char then
		local t = char:FindFirstChild("Admin Tool")
		if t and t:IsA("Tool") then
			hookTool(t)
		end
	end
end

-- Continuous scanning
task.spawn(function()
	while true do
		scanForTool()
		task.wait(1)
	end
end)

player.CharacterAdded:Connect(function()
	task.wait(2)
	scanForTool()
end)

if player:FindFirstChild("Backpack") then
	player.Backpack.ChildAdded:Connect(function(child)
		if child.Name == "Admin Tool" and child:IsA("Tool") then
			hookTool(child)
		end
	end)
end

