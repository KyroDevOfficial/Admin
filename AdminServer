--// ====================== PERMISSIONS ======================
local function getRank(player: Player): number
	local rankName = Config.UserRanks[player.UserId]
	if rankName then
		return Config.Ranks[rankName] or 0
	end
	return 0
end

local function hasPerm(player: Player, required: number): boolean
	return getRank(player) >= required
end

local function getRankName(player: Player): string
	local r = getRank(player)
	for name, val in pairs(Config.Ranks) do
		if val == r then return name end
	end
	return "None"
end

--// ====================== LOGGING ======================
local function log(executor: Player, action: string, details: string?)
	print(string.format("[ADMIN] %s → %s | %s", executor.Name, action, details or ""))
end

--// ====================== LEADERSTATS ======================
local function setupLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then return end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local function addStat(name: string, value: number)
		local stat = Instance.new("IntValue")
		stat.Name = name
		stat.Value = value
		stat.Parent = leaderstats
	end

	addStat("Coins", 0)
	addStat("Wins", 0)
	addStat("Level", 1)
	addStat("EXP", 0)
end

--// ====================== TOOL ======================
local function giveTool(player: Player)
	if not hasPerm(player, Config.Ranks.Moderator) then return end

	local function clean(container: Instance?)
		if not container then return end
		for _, obj in ipairs(container:GetChildren()) do
			if obj.Name == "Admin Tool" then
				obj:Destroy()
			end
		end
	end
	clean(player:FindFirstChild("Backpack"))
	if player.Character then clean(player.Character) end

	local tool = Instance.new("Tool")
	tool.Name = "Admin Tool"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Admin Panel"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.75, 0.75, 0.75)
	handle.Material = Enum.Material.Neon
	handle.Color = Color3.fromRGB(255, 255, 255)
	handle.CanCollide = false
	handle.Parent = tool

	tool.Equipped:Connect(function()
		local char = tool.Parent
		if not char then return end
		local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
		if not arm or not arm:IsA("BasePart") then return end

		if not arm:GetAttribute("OriginalColor") then
			arm:SetAttribute("OriginalColor", arm.Color)
		end

		local hue = 0
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not tool:IsDescendantOf(char) then
				conn:Disconnect()
				local original = arm:GetAttribute("OriginalColor")
				if original then arm.Color = original end
				return
			end
			hue = (hue + dt * 0.9) % 1
			arm.Color = Color3.fromHSV(hue, 1, 1)
		end)
	end)

	local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 5)
	if backpack then
		tool.Parent = backpack
	end
end

--// ====================== PLAYER SETUP ======================
Players.PlayerAdded:Connect(function(player)
	setupLeaderstats(player)

	player.CharacterAdded:Connect(function()
		task.wait(1.3)
		giveTool(player)
	end)

	if player.Character then
		task.defer(function()
			giveTool(player)
		end)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	setupLeaderstats(player)
	task.spawn(function()
		task.wait(1)
		giveTool(player)
	end)
end

--// ====================== HEALTH BRIDGE ======================
local HealthService = nil
local function getHealthService()
	if HealthService then return HealthService end
	local ok, mod = pcall(function()
		return require(game.ServerScriptService.HealthSystem.HealthService)
	end)
	if ok then HealthService = mod end
	return HealthService
end

