Commands.SetStat = {
	Rank = Config.Ranks.Moderator,
	Func = function(executor, target, args)
		local statName = args[1] and string.lower(args[1])
		local value = tonumber(args[2])
		if not statName or value == nil then
			return false, "Usage: setstat <name> <number>"
		end

		local char = target.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if statName == "speed" or statName == "walkspeed" then
			if hum then hum.WalkSpeed = value end
			return true, "WalkSpeed set to " .. value
		elseif statName == "jump" or statName == "jumppower" then
			if hum then hum.JumpPower = value end
			return true, "JumpPower set to " .. value
		elseif statName == "hp" or statName == "health" then
			if hum then hum.Health = value end
			return true, "Health set to " .. value
		elseif statName == "maxhp" or statName == "maxhealth" then
			if hum then
				hum.MaxHealth = value
				hum.Health = value
			end
			return true, "MaxHealth set to " .. value
		end

		local ls = target:FindFirstChild("leaderstats")
		if ls then
			local stat = ls:FindFirstChild(statName:sub(1,1):upper() .. statName:sub(2)) or ls:FindFirstChild(statName)
			if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
				stat.Value = value
				return true, stat.Name .. " set to " .. value
			end
		end

		return false, "Unknown stat"
	end
}

Commands.AddStat = {
	Rank = Config.Ranks.Moderator,
	Func = function(executor, target, args)
		local statName = args[1] and string.lower(args[1])
		local amount = tonumber(args[2]) or 0
		if not statName then return false, "Usage: addstat <name> <number>" end

		local ls = target:FindFirstChild("leaderstats")
		if not ls then return false, "No leaderstats" end

		local stat = ls:FindFirstChild(statName:sub(1,1):upper() .. statName:sub(2)) or ls:FindFirstChild(statName)
		if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
			stat.Value += amount
			return true, "Added " .. amount .. " → " .. stat.Name .. " = " .. stat.Value
		end
		return false, "Stat not found"
	end
}

