--// ====================== HANDLER (FIXED) ======================
RE_Execute.OnServerEvent:Connect(function(player: Player, cmdName: string, targetName: any, args: any)
	if typeof(cmdName) ~= "string" then return end
	args = typeof(args) == "table" and args or {}
	targetName = typeof(targetName) == "string" and targetName or nil

	if not hasPerm(player, Config.Ranks.Moderator) then
		RE_Notify:FireClient(player, "No permission")
		return
	end

	local cmd = Commands[cmdName]
	if not cmd then
		RE_Notify:FireClient(player, "Unknown command: " .. tostring(cmdName))
		return
	end

	if not hasPerm(player, cmd.Rank) then
		RE_Notify:FireClient(player, "Insufficient rank")
		return
	end

	-- Target resolution
	local target: Player = player

	if targetName and targetName ~= "" and targetName:lower() ~= "me" and targetName:lower() ~= "self" then
		local found = false
		local search = targetName:lower()

		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower() == search or p.DisplayName:lower() == search then
				target = p
				found = true
				break
			end
		end

		if not found then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower():find(search, 1, true) or p.DisplayName:lower():find(search, 1, true) then
					target = p
					found = true
					break
				end
			end
		end

		if not found then
			local id = tonumber(targetName)
			if id then
				local p = Players:GetPlayerByUserId(id)
				if p then
					target = p
					found = true
				end
			end
		end

		if not found then
			RE_Notify:FireClient(player, "Player not found: " .. targetName)
			return
		end
	end

	local success, result = pcall(function()
		return cmd.Func(player, target, args)
	end)

	if success then
		local msg = result
		if typeof(result) == "string" then
			RE_Notify:FireClient(player, msg)
			log(player, cmdName, msg)
		else
			RE_Notify:FireClient(player, "Done")
		end
	else
		RE_Notify:FireClient(player, "Error running command")
		warn("[Admin Error]", result)
	end
end)

