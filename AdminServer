Commands.Fly = {
	Rank = Config.Ranks.Admin,
	Func = function(executor, target)
		local char = target.Character
		if not char then return false, "No character" end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return false, "Missing parts" end

		if hrp:FindFirstChild("AdminFlyBV") then
			hrp.AdminFlyBV:Destroy()
			if hrp:FindFirstChild("AdminFlyBG") then hrp.AdminFlyBG:Destroy() end
			hum.PlatformStand = false
			return true, "Fly disabled"
		end

		hum.PlatformStand = true

		local bv = Instance.new("BodyVelocity")
		bv.Name = "AdminFlyBV"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp

		local bg = Instance.new("BodyGyro")
		bg.Name = "AdminFlyBG"
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bg.P = 9000
		bg.Parent = hrp

		task.spawn(function()
			local speed = 70
			while bv.Parent and char and hum do
				local move = hum.MoveDirection
				local camCF = workspace.CurrentCamera.CFrame
				local dir = (camCF.LookVector * -move.Z + camCF.RightVector * move.X)
				bv.Velocity = Vector3.new(dir.X * speed, bv.Velocity.Y, dir.Z * speed)
				if hum.Jump then
					bv.Velocity = bv.Velocity + Vector3.new(0, 50, 0)
				end
				bg.CFrame = camCF
				task.wait()
			end
		end)

		return true, "Fly enabled"
	end
}

